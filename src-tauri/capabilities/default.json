{
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:path:allow-resolve-directory",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-temp-write",
    "fs:allow-temp-read"
  ]
}